# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Derived/rebuildable data — not source, regenerated by
# `python -m ingestion.load_vectorstore` (see README)
chroma_db/

# Third-party OCR model file — not project source, see README for download
tessdata/*.traineddata

# Node / Next.js (web/.gitignore already covers these inside web/, repeated
# here so a root-level `git status` never surprises with thousands of files)
web/node_modules/
web/.next/
web/out/
web/lib/generated/
web/.vercel
web/*.tsbuildinfo
web/next-env.d.ts

# Claude Code local session state — not project source
.claude/

# OS/editor
.DS_Store
*.log
